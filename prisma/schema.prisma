generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  password      String

  goals         Goal[]
  skillProgress SkillProgress[]
  sessions      Session[]

  createdAt     DateTime        @default(now())
}

model Goal {
  id             String          @id @default(uuid())
  title          String
  estimatedWeeks Int
  status         GoalStatus      @default(CREATING)

  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id])

  goalSkills     GoalSkill[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([ownerId])
}

model Skill {
  id          String      @id @default(uuid())
  skillKey    String      @unique
  title       String
  description String

  goalSkills  GoalSkill[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model GoalSkill {
  id String @id @default(uuid())

  goalId String
  goal Goal @relation(fields: [goalId], references: [id])

  skillId String
  skill Skill @relation(fields: [skillId], references: [id])

  position Int
  description String
  whyImportant String
  milestone String
  projectChallenge String

  lessonOverview String?
  lessonKeyIdeas String?
  lessonContent String?
  lessonPractice String?

  dependencies GoalSkillDependency[] @relation("DependentSkill")
  dependents   GoalSkillDependency[] @relation("PrerequisiteSkill")

  progress SkillProgress[]

  @@unique([goalId, skillId])
  @@unique([goalId, position])
  @@index([goalId])
  @@index([skillId])
}

model GoalSkillDependency {
  id String @id @default(uuid())

  goalSkill GoalSkill @relation("DependentSkill", fields: [goalSkillId], references: [id])
  goalSkillId String

  prerequisiteGoalSkill GoalSkill @relation("PrerequisiteSkill", fields: [prerequisiteGoalSkillId], references: [id])
  prerequisiteGoalSkillId String

  @@unique([goalSkillId, prerequisiteGoalSkillId])
  @@index([prerequisiteGoalSkillId])
}

model SkillProgress {
  id String @id @default(uuid())

  user User @relation(fields: [userId], references: [id])
  userId String

  goalSkill GoalSkill @relation(fields: [goalSkillId], references: [id])
  goalSkillId String

  status SkillStatus @default(NOT_STARTED)

  projectStartedAt DateTime?
  completedAt DateTime?
  updatedAt DateTime @updatedAt

  evidence Evidence[]

  @@unique([userId, goalSkillId])
  @@index([userId, status])
  @@index([goalSkillId])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}

model Evidence {
  id             String        @id @default(uuid())
  skillProgressId String
  response       String
  passed         Boolean
  score          Int
  feedback       String
  criteriaResults Json
  createdAt      DateTime      @default(now())

  skillProgress SkillProgress @relation(fields: [skillProgressId], references: [id])

  @@index([skillProgressId, createdAt])
}

enum GoalStatus {
  CREATING
  READY
}

enum SkillStatus {
  NOT_STARTED
  EXPLORING
  PRACTICING
  APPLYING
  MASTERED
}
